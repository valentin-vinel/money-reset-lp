---
import EnteteSection from '../ui/EnteteSection.astro';
import { fr } from '../../lib/format';

interface Props {
  titre: string;
  liste: { titre: string; texte: string }[];
}
const { titre, liste } = Astro.props;
---

<section class="section etapes" id="comment-ca-marche" aria-labelledby="etapes-titre">
  <div class="conteneur">
    <EnteteSection id="etapes-titre" titre={titre} align="centre" />

    <ol class="etapes__liste">
      {
        liste.map((e, i) => (
          <li>
            <span class="etapes__numero" aria-hidden="true">{i + 1}</span>
            <h3>{fr(e.titre)}</h3>
            <p>{fr(e.texte)}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .etapes__liste {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    position: relative;
  }
  .etapes__liste::before {
    content: '';
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    right: calc(33.33% - 1.5rem);
    border-top: 2px dashed var(--trait-fort);
  }
  .etapes__liste li {
    position: relative;
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .etapes__numero {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--bordeaux);
    color: var(--creme);
    font-family: var(--f-titre);
    font-size: 1.4rem;
    box-shadow: 0 0 0 8px var(--blanc);
    margin-bottom: 0.5rem;
  }
  .etapes__liste h3 {
    font-size: 1.5rem;
  }
  .etapes__liste p {
    color: var(--texte-doux);
    max-width: 22em;
  }

  @media (max-width: 52rem) {
    .etapes__liste {
      grid-template-columns: 1fr;
    }
    .etapes__liste::before {
      top: 1.5rem;
      bottom: 1.5rem;
      left: 1.5rem;
      right: auto;
      border-top: 0;
      border-left: 2px dashed var(--trait-fort);
    }
    .etapes__liste li {
      grid-template-columns: 3rem 1fr;
      column-gap: 1.25rem;
    }
    .etapes__numero {
      grid-row: span 2;
      margin: 0;
    }
  }
</style>
