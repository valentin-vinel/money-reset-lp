---
import { navigation, site } from '../../config/site';
import { url } from '../../lib/format';
const annee = new Date().getFullYear();
---

<footer class="pied">
  <div class="conteneur pied__haut">
    <a class="pied__marque" href={url()}>
      <img src={url('logo.jpg')} alt="" width="44" height="44" loading="lazy" />
      <span>
        <strong>{site.nom}</strong>
        <small>par {site.autrice}, {site.marque}</small>
      </span>
    </a>
    <nav aria-label="Pied de page">
      {navigation.map((l) => <a href={`#${l.ancre}`}>{l.libelle}</a>)}
      {site.email && <a href={`mailto:${site.email}`}>Contact</a>}
      {site.instagram && <a href={site.instagram} rel="noopener">Instagram</a>}
    </nav>
  </div>
  <div class="conteneur pied__bas">
    <p>© {annee} {site.marque}</p>
  </div>
</footer>

<style>
  .pied {
    border-top: 1px solid var(--trait);
    padding-block: 2.5rem 6rem;
    font-size: 0.925rem;
  }
  .pied__haut {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }
  .pied__marque {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }
  .pied__marque img {
    width: 44px;
    height: 44px;
    border-radius: 11px;
  }
  .pied__marque span {
    display: grid;
    line-height: 1.3;
  }
  .pied__marque strong {
    font-family: var(--f-titre);
    font-weight: 400;
    font-size: 1.2rem;
  }
  .pied__marque small {
    color: var(--texte-doux);
    font-size: 0.85rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
  }
  nav a {
    text-decoration: none;
    color: var(--texte-doux);
  }
  nav a:hover {
    color: var(--bordeaux);
  }
  .pied__bas {
    margin-top: 2rem;
    color: var(--texte-doux);
    font-size: 0.85rem;
  }
  @media (min-width: 52rem) {
    .pied {
      padding-bottom: 2.5rem;
    }
  }
</style>
