---
/**
 * « Ce que tu as à la fin » (liste `inclus` de l'offre, avec coches)
 * et « Pour toi si… » (liste `pourQui`), côte à côte sur grand écran.
 */
import Icone from '../ui/Icone.astro';
import { fr } from '../../lib/format';

interface Props {
  titreResultats: string;
  resultats: string[];
  pourQui: string[];
}
const { titreResultats, resultats, pourQui } = Astro.props;
---

<section class="section listes-offre" aria-label="Résultats et public de l’offre">
  <div class="conteneur listes-offre__grille">
    <div class="listes-offre__bloc">
      <h2>{fr(titreResultats)}</h2>
      <ul class="listes-offre__resultats">
        {
          resultats.map((r) => (
            <li>
              <Icone nom="coche" taille={16} />
              <span>{fr(r)}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="listes-offre__bloc listes-offre__bloc--pour-qui">
      <h2>Pour toi si…</h2>
      <ul class="listes-offre__pour-qui">
        {pourQui.map((p) => <li>{fr(p)}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .listes-offre__grille {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .listes-offre__bloc {
    display: grid;
    gap: 1.5rem;
  }
  .listes-offre h2 {
    font-size: clamp(2rem, 4vw, 2.75rem);
  }
  .listes-offre__resultats {
    list-style: none;
    display: grid;
    gap: 0.85rem;
    font-size: 1.05rem;
  }
  .listes-offre__resultats li {
    display: grid;
    grid-template-columns: 1.6rem 1fr;
    gap: 0.75rem;
  }
  .listes-offre__resultats :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
    padding: 0.25rem;
    border-radius: 50%;
    background: var(--bleu-pale);
    color: var(--bordeaux);
  }
  /* Encadré crème pâle, comme « Pour toi si… » de la formule mise en avant. */
  .listes-offre__bloc--pour-qui {
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    border-radius: var(--r-l);
    background: var(--creme-pale);
  }
  .listes-offre__bloc--pour-qui h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
  }
  .listes-offre__pour-qui {
    display: grid;
    gap: 0.75rem;
    padding-left: 1.1rem;
    color: var(--texte-doux);
  }

  @media (max-width: 52rem) {
    .listes-offre__grille {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
