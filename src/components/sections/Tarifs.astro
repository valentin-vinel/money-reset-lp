---
import type { CollectionEntry } from 'astro:content';
import EnteteSection from '../ui/EnteteSection.astro';
import Bouton from '../ui/Bouton.astro';
import Icone from '../ui/Icone.astro';
import { fr, prix } from '../../lib/format';

interface Props {
  titre: string;
  intro: string;
  conseil: string;
  offres: CollectionEntry<'offres'>[];
}
const { titre, intro, conseil, offres } = Astro.props;
---

<section class="section tarifs" id="formules" aria-labelledby="tarifs-titre">
  <div class="conteneur tarifs__conteneur">
    <EnteteSection id="tarifs-titre" titre={titre} intro={intro} align="centre" uneLigne />

    <div class="tarifs__grille" style={`--colonnes: ${offres.length}`}>
      {
        offres.map(({ id, data: o }) => {
          const phare = Boolean(o.etiquette);
          return (
            <article class:list={['offre', { 'offre--phare': phare }]} aria-labelledby={`offre-${id}`}>
              {phare && <span class="offre__rayures" aria-hidden="true" />}
              <header class="offre__tete">
                <div class="offre__noms">
                  <h3 id={`offre-${id}`}>{o.nom}</h3>
                  {o.etiquette && <span class="offre__etiquette">{fr(o.etiquette)}</span>}
                </div>
                <p class="offre__titre">{fr(o.titre)}</p>
              </header>

              <p class="offre__prix">
                <span class="offre__montant">{prix(o.prix)}</span>
                <span class="offre__modalite">{fr(o.prixDetail ?? o.modalite)}</span>
              </p>

              <Bouton href={o.lien} taille="l" pleineLargeur>
                {fr(o.bouton)}
              </Bouton>

              <div class="offre__bloc">
                <p class="offre__sous-titre">{o.inclusIntro ? fr(o.inclusIntro) : 'Ce que tu reçois'}</p>
                <ul class="offre__liste">
                  {o.inclus.map((item) => (
                    <li>
                      <Icone nom={o.inclusIntro ? 'plus' : 'coche'} taille={16} />
                      <span>{fr(item)}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="offre__bloc offre__bloc--pour-qui">
                <p class="offre__sous-titre">Pour toi si…</p>
                <ul class="offre__pour-qui">
                  {o.pourQui.map((p) => (
                    <li>{fr(p)}</li>
                  ))}
                </ul>
              </div>
            </article>
          );
        })
      }
    </div>

    <div class="tarifs__pied">
      <p class="tarifs__conseil">{fr(conseil)}</p>
    </div>
  </div>
</section>

<style>
  /* Haut teinté (bleu pâle) qui se fond vers le blanc : marque la rupture avec
     la section Étapes, blanche, au-dessus. Le halo radial reste derrière les cartes. */
  .tarifs {
    border-top: 1px solid var(--trait);
    background:
      radial-gradient(56rem 30rem at 50% 45%, var(--bleu-pale), transparent 70%),
      linear-gradient(180deg, var(--bleu-pale) 0%, var(--bleu-voile) 30%, var(--blanc) 75%);
  }
  /* Pleine largeur pour aligner toutes les cartes sur une ligne en grand écran */
  .tarifs__conteneur {
    max-width: none;
  }
  .tarifs__grille {
    display: grid;
    grid-template-columns: repeat(var(--colonnes), minmax(0, 27rem));
    justify-content: center;
    gap: 1.25rem;
    align-items: stretch;
  }
  /* Sous-grille : les 5 blocs de la carte (tête, prix, bouton, inclus, pour qui) partagent
     les lignes de la grille, pour que prix et boutons soient alignés d'une carte à l'autre. */
  .offre {
    position: relative;
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    gap: 1.5rem;
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    border-radius: var(--r-l);
    background: var(--blanc);
    border: 1px solid var(--trait-fort);
    box-shadow: var(--ombre);
    overflow: hidden;
  }
  /* Bordure bordeaux de 2px : le second trait passe par l'ombre pour ne pas décaler le contenu */
  .offre--phare {
    border-color: var(--bordeaux);
    box-shadow: 0 0 0 1px var(--bordeaux), var(--ombre-forte);
  }
  .offre__rayures {
    position: absolute;
    inset: 0 0 auto;
    height: 0.6rem;
    background: var(--rayures);
  }
  .offre__tete {
    display: grid;
    gap: 0.4rem;
  }
  .offre__noms {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .offre h3 {
    font-size: 2rem;
  }
  .offre__etiquette {
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    background: var(--bordeaux);
    color: var(--creme);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .offre__titre {
    color: var(--texte-doux);
  }
  /* Mention (modalité de paiement) toujours sous le montant */
  .offre__prix {
    display: grid;
    gap: 0.15rem;
  }
  .offre__montant {
    font-family: var(--f-titre);
    font-size: clamp(3.5rem, 7vw, 4.5rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  .offre__modalite {
    font-size: 0.95rem;
    color: var(--texte-doux);
  }
  .offre__bloc {
    display: grid;
    gap: 0.85rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--trait);
  }
  /* « Pour toi si… » en encadré : bleu clair, jaune clair pour la formule mise en avant. */
  .offre__bloc--pour-qui {
    margin-top: auto;
    padding: 1.25rem 1.25rem 1.35rem;
    border-top: 0;
    border-radius: var(--r-m);
    background: var(--bleu-pale);
  }
  .offre--phare .offre__bloc--pour-qui {
    background: var(--creme-pale);
  }
  .offre__sous-titre {
    font-weight: 700;
  }
  .offre__liste {
    list-style: none;
    display: grid;
    gap: 0.55rem;
    font-size: 0.975rem;
  }
  .offre__liste li {
    display: grid;
    grid-template-columns: 1.4rem 1fr;
    gap: 0.6rem;
  }
  .offre__liste :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
    padding: 0.2rem;
    border-radius: 50%;
    background: var(--bleu-pale);
    color: var(--bordeaux);
  }
  .offre__pour-qui {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.1rem;
    font-size: 0.925rem;
    color: var(--texte-doux);
  }

  .tarifs__pied {
    max-width: 55rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) auto 0;
    display: grid;
    gap: 1.25rem;
    justify-items: center;
    text-align: center;
  }
  .tarifs__conseil {
    color: var(--texte-doux);
    max-width: 40em;
  }

  /* En dessous, 4 cartes côte à côte deviennent trop étroites : on passe à 2 par ligne */
  @media (max-width: 80rem) {
    .tarifs__grille {
      grid-template-columns: repeat(2, minmax(0, 27rem));
    }
  }
  /* Mobile : carrousel horizontal. La grille déborde jusqu'aux bords de l'écran et
     la carte suivante dépasse à droite pour inviter à faire défiler. */
  @media (max-width: 52rem) {
    .tarifs__grille {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(85%, 24rem);
      justify-content: start;
      gap: 1rem;
      margin-inline: calc(-1 * var(--gouttiere));
      padding: 0.5rem var(--gouttiere) 1.5rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gouttiere);
      scrollbar-width: none;
    }
    .tarifs__grille::-webkit-scrollbar {
      display: none;
    }
    .offre {
      scroll-snap-align: start;
    }
  }
</style>
