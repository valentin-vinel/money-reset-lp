---
import type { CollectionEntry } from 'astro:content';
import EnteteSection from '../ui/EnteteSection.astro';
import CarteOffre from '../ui/CarteOffre.astro';
import { fr } from '../../lib/format';

interface Props {
  titre: string;
  intro: string;
  conseil: string;
  offres: CollectionEntry<'offres'>[];
}
const { titre, intro, conseil, offres } = Astro.props;
---

<section class="section tarifs" id="formules" aria-labelledby="tarifs-titre">
  <div class="conteneur">
    <EnteteSection id="tarifs-titre" titre={titre} intro={intro} align="centre" uneLigne />

    <div class="tarifs__grille">
      {offres.map((offre) => <CarteOffre offre={offre} phare={Boolean(offre.data.etiquette)} />)}
    </div>

    <div class="tarifs__pied">
      <p class="tarifs__conseil">{fr(conseil)}</p>
    </div>
  </div>
</section>

<style>
  /* Haut teinté (bleu pâle) qui se fond vers le blanc : marque la rupture avec
     la section Étapes, blanche, au-dessus. Le halo radial reste derrière les cartes. */
  .tarifs {
    border-top: 1px solid var(--trait);
    background:
      radial-gradient(56rem 30rem at 50% 45%, var(--bleu-pale), transparent 70%),
      linear-gradient(180deg, var(--bleu-pale) 0%, var(--bleu-voile) 30%, var(--blanc) 75%);
  }
  .tarifs__grille {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 27rem));
    justify-content: center;
    gap: 1.25rem;
    align-items: stretch;
  }
  .tarifs__pied {
    max-width: 55rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) auto 0;
    display: grid;
    gap: 1.25rem;
    justify-items: center;
    text-align: center;
  }
  .tarifs__conseil {
    color: var(--texte-doux);
    max-width: 40em;
  }

  @media (max-width: 52rem) {
    .tarifs__grille {
      grid-template-columns: minmax(0, 32rem);
    }
  }
</style>
