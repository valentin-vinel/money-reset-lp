---
/**
 * Fenêtre de choix du paiement (comptant, en plusieurs fois…).
 * S'ouvre depuis tout élément portant `data-ouvre-paiement="<id>"` ; se ferme avec la croix,
 * Échap ou un clic à côté.
 */
import Icone from './Icone.astro';
import { fr } from '../../lib/format';

interface Props {
  id: string;
  /** Nom de l'offre, rappelé au-dessus du titre. */
  offre: string;
  titre: string;
  texte?: string;
  options: { libelle: string; montant: string; detail?: string; lien: string }[];
  mention?: string;
}
const { id, offre, titre, texte, options, mention } = Astro.props;
---

<dialog class="modale" id={id} aria-labelledby={`${id}-titre`}>
  <div class="modale__corps">
    <form method="dialog">
      <button class="modale__fermer" aria-label="Fermer">
        <Icone nom="croix" taille={20} />
      </button>
    </form>

    <p class="modale__offre">{fr(offre)}</p>
    <h2 class="modale__titre" id={`${id}-titre`}>{fr(titre)}</h2>
    {texte && <p class="modale__texte">{fr(texte)}</p>}

    <ul class="modale__options">
      {
        options.map((o) => (
          <li>
            <a class="option-paiement" href={o.lien}>
              <span class="option-paiement__texte">
                <strong>{fr(o.libelle)}</strong>
                {o.detail && <span>{fr(o.detail)}</span>}
              </span>
              <span class="option-paiement__montant">{fr(o.montant)}</span>
              <Icone nom="fleche" taille={20} class="option-paiement__fleche" />
            </a>
          </li>
        ))
      }
    </ul>

    {
      mention && (
        <p class="modale__mention">
          <Icone nom="cadenas" taille={16} />
          {fr(mention)}
        </p>
      )
    }
  </div>
</dialog>

<script>
  document.querySelectorAll<HTMLElement>('[data-ouvre-paiement]').forEach((declencheur) => {
    declencheur.addEventListener('click', (e) => {
      const modale = document.getElementById(declencheur.dataset.ouvrePaiement ?? '');
      if (!(modale instanceof HTMLDialogElement)) return;
      e.preventDefault();
      modale.showModal();
    });
  });
  // Clic sur le fond (hors du contenu) : on ferme.
  document.querySelectorAll<HTMLDialogElement>('dialog.modale').forEach((modale) => {
    modale.addEventListener('click', (e) => {
      if (e.target === modale) modale.close();
    });
  });
</script>

<style>
  .modale {
    width: min(30rem, calc(100% - 2 * var(--gouttiere)));
    max-height: calc(100% - 2 * var(--gouttiere));
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--r-l);
    background: var(--blanc);
    color: var(--texte);
    box-shadow: var(--ombre-forte);
    overflow: auto;
  }
  .modale::backdrop {
    background: rgb(87 21 52 / 0.45);
    backdrop-filter: blur(2px);
  }
  .modale[open] {
    animation: modale-entree 0.22s ease-out;
  }
  @keyframes modale-entree {
    from {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.98);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .modale[open] {
      animation: none;
    }
  }
  /* Page figée derrière la fenêtre */
  :global(html:has(dialog.modale[open])) {
    overflow: hidden;
  }

  .modale__corps {
    position: relative;
    display: grid;
    gap: 0.6rem;
    padding: clamp(1.5rem, 5vw, 2.25rem);
  }
  .modale__fermer {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--texte-doux);
    cursor: pointer;
    transition: background-color 0.18s ease;
  }
  .modale__fermer:hover {
    background: var(--bleu-pale);
    color: var(--bordeaux);
  }
  .modale__offre {
    padding-right: 2.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--texte-doux);
  }
  .modale__titre {
    font-size: clamp(1.6rem, 5vw, 2rem);
  }
  .modale__texte {
    color: var(--texte-doux);
  }

  .modale__options {
    list-style: none;
    display: grid;
    gap: 0.75rem;
    margin-top: 0.9rem;
  }
  .option-paiement {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 0.9rem;
    padding: 1.1rem 1.15rem 1.1rem 1.35rem;
    border: 1.5px solid var(--trait-fort);
    border-radius: var(--r-m);
    background: var(--blanc);
    color: var(--bordeaux);
    text-decoration: none;
    transition:
      border-color 0.18s ease,
      background-color 0.18s ease;
  }
  .option-paiement:hover {
    border-color: var(--bordeaux);
    background: var(--creme-pale);
  }
  .option-paiement__texte {
    display: grid;
    gap: 0.15rem;
  }
  .option-paiement__texte span {
    font-size: 0.9rem;
    color: var(--texte-doux);
  }
  .option-paiement__montant {
    font-family: var(--f-titre);
    font-size: 1.5rem;
    white-space: nowrap;
  }
  .option-paiement :global(.option-paiement__fleche) {
    transition: transform 0.18s ease;
  }
  .option-paiement:hover :global(.option-paiement__fleche) {
    transform: translateX(3px);
  }

  .modale__mention {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--texte-doux);
  }
</style>
